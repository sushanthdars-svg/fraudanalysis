# Production Environment Configuration
# NEVER commit this file with actual values!
# Use secrets management (AWS Secrets Manager, Azure Key Vault, etc.)

# ============================================
# CORE APPLICATION SETTINGS
# ============================================

# Environment indicator
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Application secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=<GENERATE_STRONG_SECRET_KEY>

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.yourdomain.com
API_WORKERS=8

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Use managed MySQL service (RDS, Azure Database, etc.)
# Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://fraud_user:<PASSWORD>@db.your-region.rds.amazonaws.com:3306/fraud_detection

# Connection pool configuration
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT Configuration
JWT_SECRET_KEY=<GENERATE_STRONG_SECRET_KEY>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# HTTPS/TLS Configuration
ENFORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# SSL Certificate paths (if using custom certificates)
# SSL_CERT_FILE=/etc/ssl/certs/your-cert.crt
# SSL_KEY_FILE=/etc/ssl/private/your-key.key

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600
RATE_LIMIT_PER_IP=true

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================

# Use managed Redis (ElastiCache, Azure Cache, etc.)
REDIS_URL=redis://redis.your-region.cache.amazonaws.com:6379/0
# Or individual settings:
# REDIS_HOST=redis.your-region.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=<PASSWORD>

# Connection pool
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=5
REDIS_CONNECTION_TIMEOUT=5

# Cache TTLs (Time to Live in seconds)
CACHE_TTL_ALERTS=300
CACHE_TTL_RISK_SCORE=600
CACHE_TTL_CUSTOMER_PROFILE=1800
CACHE_TTL_FRAUD_RULES=3600

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log Level
LOG_LEVEL=WARNING
LOG_CONSOLE_ENABLED=true
LOG_FILE=/app/logs/app.log
LOG_FORMAT=json

# Log Rotation
LOG_BACKUP_COUNT=7
LOG_MAX_SIZE=104857600  # 100MB

# Structured Logging
LOG_INCLUDE_REQUEST_ID=true
LOG_INCLUDE_USER_ID=true
LOG_INCLUDE_PERFORMANCE_METRICS=true
LOG_INCLUDE_AUDIT_INFO=true

# ============================================
# ML MODEL CONFIGURATION
# ============================================

# Model paths
ML_MODEL_DIR=/app/models
ML_FRAUD_MODEL=fraud_detection_model.pkl
ML_RISK_MODEL=risk_assessment_model.pkl
ML_MODEL_VERSION=1.0.0

# Model settings
ML_ENABLE_AUTO_UPDATE=false
ML_MIN_CONFIDENCE_THRESHOLD=0.65
ML_HIGH_CONFIDENCE_THRESHOLD=0.85

# ============================================
# MONITORING & ALERTING
# ============================================

# Enable metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090

# Application Insights / CloudWatch
# INSIGHTS_INSTRUMENTATION_KEY=<KEY>
# CLOUDWATCH_LOG_GROUP=/fraud-detection/app

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=<WEBHOOK_URL>
# SLACK_ALERT_CHANNEL=#fraud-alerts

# Email notifications (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<USERNAME>
# SMTP_PASSWORD=<PASSWORD>
# SMTP_FROM=alerts@yourdomain.com

# ============================================
# PERFORMANCE TUNING
# ============================================

# Request handling
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10  # MB
KEEP_ALIVE=5

# Pagination
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=1000

# Transaction processing
BULK_UPLOAD_MAX_RECORDS=10000
BULK_UPLOAD_TIMEOUT_SECONDS=300
BULK_UPLOAD_BATCH_SIZE=1000

# ============================================
# COMPLIANCE & AUDIT
# ============================================

# Compliance settings
COMPLIANCE_MODE=strict
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=90

# Data retention
TRANSACTION_RETENTION_DAYS=730  # 2 years
ALERT_RETENTION_DAYS=365  # 1 year
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_TRANSACTION_UPLOAD=true
ENABLE_ALERTS_DASHBOARD=true
ENABLE_INVESTIGATION_CASES=true
ENABLE_RISK_ASSESSMENT=true
ENABLE_ML_MODELS=true
ENABLE_AUDIT_LOG_VIEWER=true

# ============================================
# DASHBOARD CONFIGURATION
# ============================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_LOGGER_LEVEL=warning
STREAMLIT_CLIENT_LOGGER_LEVEL=warning
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=false

# Dashboard refresh intervals (seconds)
ALERTS_REFRESH_INTERVAL=60
CASES_REFRESH_INTERVAL=120
METRICS_REFRESH_INTERVAL=300

# ============================================
# SECURITY HARDENING CHECKLIST
# ============================================

# Verify before production deployment:
# [ ] ENVIRONMENT=production (NOT staging/development)
# [ ] DEBUG=false (NEVER true in production)
# [ ] SECRET_KEY is strong and 32+ characters
# [ ] JWT_SECRET_KEY is strong and different from SECRET_KEY
# [ ] DATABASE_URL uses managed database service
# [ ] ALLOWED_ORIGINS contains only production domains
# [ ] ENFORCE_HTTPS=true
# [ ] All password policy flags are true
# [ ] SESSION_TIMEOUT_MINUTES<=30
# [ ] RATE_LIMIT_ENABLED=true
# [ ] LOG_LEVEL=WARNING or ERROR
# [ ] SMTP/email notifications configured
# [ ] Slack notifications configured (if needed)
# [ ] SSL/TLS certificates configured
# [ ] Redis backed by managed service (if used)
# [ ] Database backups configured
# [ ] Monitoring and alerting configured
# [ ] .env file NOT in git (added to .gitignore)
# [ ] Secrets stored in secure vault (AWS Secrets Manager, etc.)

# ============================================
# DEPLOYMENT INSTRUCTIONS
# ============================================

# 1. Copy this file:
#    cp .env.production .env
#
# 2. Update all <PLACEHOLDER> values with actual production values
#
# 3. Verify all security checklist items above
#
# 4. DO NOT commit .env to git repository
#
# 5. Use secrets management system:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#    - Kubernetes Secrets
#
# 6. Load environment variables at deployment time:
#    export $(cat .env | grep -v '^#' | xargs)
#
# 7. Verify configuration:
#    python -c "from app.core.config import settings; print(settings)"

# End of configuration file
