# Database Configuration
DATABASE_URL=mysql+pymysql://fraud_user:your_password@localhost:3306/fraud_detection_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraud_detection_db
DB_USER=fraud_user
DB_PASSWORD=your_secure_password

# FastAPI Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
DEBUG=True

# JWT Configuration
SECRET_KEY=your_super_secret_key_change_in_production_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Admin User (set during initialization)
ADMIN_EMAIL=admin@fraud-detection.local
ADMIN_PASSWORD=SecureAdminPassword123!

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
API_BASE_URL=http://127.0.0.1:8000

# Model Configuration
ML_MODEL_THRESHOLD=0.5
ENABLE_ML_DETECTION=True

# Dataset Configuration
DATASET_PATH=data/raw/creditcard.csv
SYNTHETIC_DATA_SIZE=10000

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
